{
  "datasets": [
    {
      "name": "8f4be40d",
      "displayName": "EarthQuake_Detail",
      "queryLines": [
        "SELECT * FROM youtube_dev.silver.earthquake_data_final"
      ]
    },
    {
      "name": "21ab9b03",
      "displayName": "EarthQuake_Type",
      "queryLines": [
        "SELECT count(*) AS total_magnitude_bucket,magnitude_bucket FROM (\r\n",
        "SELECT CASE\r\n",
        "WHEN mag < 2 THEN 'Micro (<2)'\r\n",
        "WHEN mag BETWEEN 2 AND 3 THEN 'Minor (2-3)'\r\n",
        "WHEN mag BETWEEN 3 AND 4 THEN 'Light (3-4)'\r\n",
        "ELSE 'Moderate+ (4+)'\r\n",
        "END AS magnitude_bucket\r\n",
        "FROM youtube_dev.silver.earthquake_data_final)\r\n",
        "GROUP BY magnitude_bucket"
      ]
    },
    {
      "name": "3985805c",
      "displayName": "Earthquake_Country",
      "queryLines": [
        "SELECT\r\n",
        "    COUNT(*) AS event_count,\r\n",
        "    CASE\r\n",
        "        WHEN get(split(place, ', '), 1) IN (\r\n",
        "            'CA',\r\n",
        "            'Alaska',\r\n",
        "            'Hawaii',\r\n",
        "            'Washington',\r\n",
        "            'New Mexico',\r\n",
        "            'Puerto Rico',\r\n",
        "            'Utah',\r\n",
        "            'Tennessee',\r\n",
        "            'U.S. Virgin Islands',\r\n",
        "            'Texas'\r\n",
        "        ) THEN 'USA'\r\n",
        "        ELSE get(split(place, ', '), 1)\r\n",
        "    END AS places\r\n",
        "FROM youtube_dev.silver.earthquake_data_final\r\n",
        "GROUP BY places\r\n",
        "ORDER BY event_count DESC;"
      ]
    }
  ],
